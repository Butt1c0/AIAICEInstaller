{
  "name": "aiaice-installer",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "backend": "npm run dev --workspace=backend",
    "frontend": "npm run dev --workspace=frontend",
    "dev": "npm run backend & npm run frontend",
    "install:all": "npm install --workspace=backend && npm install --workspace=frontend"
  }
}
